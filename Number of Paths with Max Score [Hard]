class Solution(object):
    def pathsWithMaxScore(self, board):
        """
        :type board: List[str]
        :rtype: List[int]
        """
        n = len(board)
        MOD = 10**9 + 7

        grid = []
        for word in board:
            grid.append(list(word))
        grid[0][0] = 'E'
        grid[-1][-1] = 'S'

        dp = [[(-1,0) for _ in range(n)] for _ in range(n)]
        dp[n-1][n-1] = (0,1)

        directions = [(1,0),(0,1),(1,1)]

        for i in range(n-1, -1, -1):
            for j in range(n-1, -1, -1):
                if grid[i][j] == 'X':
                    continue
                if i == n-1 and j == n-1:
                    continue
                
                bestscore = -1
                ways = 0


                for di, dj in directions:
                    ni, nj = i+di, j+dj
                    if ni < n and nj < n:
                        score, cnt = dp[ni][nj]
                        if score == -1:
                            continue
                        if score > bestscore:
                            bestscore = score
                            ways = cnt
                        elif score == bestscore:
                            ways = (ways + cnt) % MOD

                if bestscore == -1:
                    continue
                
                addval = 0
                if grid[i][j].isdigit():
                    addval = int(grid[i][j])

                dp[i][j] = (bestscore + addval, ways %MOD)

        maxscore, numpaths = dp[0][0]
        if maxscore == -1:
            return [0,0]
        return [maxscore, numpaths % MOD]


        
