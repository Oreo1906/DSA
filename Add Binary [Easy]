Given two binary strings a and b, return their sum as a binary string.

 

Example 1:

Input: a = "11", b = "1"
Output: "100"
Example 2:

Input: a = "1010", b = "1011"
Output: "10101"

Solution : 

class Solution(object):
    def addBinary(self, a, b):
        binary = ""
        carry = 0

        # iterate from rightmost digits
        for i, j in zip(reversed(a), reversed(b)):
            total = int(i) + int(j) + carry
            if total == 0:
                binary += "0"
                carry = 0
            elif total == 1:
                binary += "1"
                carry = 0
            elif total == 2:
                binary += "0"
                carry = 1
            else:  # total == 3
                binary += "1"
                carry = 1

        # handle leftover digits if lengths differ
        longer = a if len(a) > len(b) else b
        for k in reversed(longer[:abs(len(a)-len(b))]):
            total = int(k) + carry
            if total == 0:
                binary += "0"
                carry = 0
            elif total == 1:
                binary += "1"
                carry = 0
            else:  # total == 2
                binary += "0"
                carry = 1

        # final carry
        if carry:
            binary += "1"

        return binary[::-1]  # reverse result
