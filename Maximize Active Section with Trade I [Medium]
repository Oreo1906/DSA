class Solution(object):
    def maxActiveSectionsAfterTrade(self, s):
        """
        :type s: str
        :rtype: int
        """
        if "1" not in s:
            return 0

        if len(s) == 2:
            return s.count("1")
    
        arr = []
        for i in range(len(s)):
            if s[i] =="0":
                arr.append(-1)
            else:
                arr.append(1)

        arr = [1]
        i = 0
        zero = 0
        one = 0
        while i < len(s):
            zero = 0
            while i < len(s) and s[i] == "0":
                zero -= 1
                i += 1
            if zero < 0:
                arr.append(zero)

            one = 0
            while i < len(s) and s[i] == "1":
                one += 1
                i += 1
            if one > 0:
                arr.append(one)
        arr.append(1)

        total_ones = s.count("1")

        max_delta = 0
        for i in range(1, len(arr) - 1):
            if arr[i] > 0 and arr[i-1] < 0 and arr[i+1] < 0:
                delta = abs(arr[i-1]) + abs(arr[i+1])
                max_delta = max(max_delta, delta)

        return total_ones + max_delta
