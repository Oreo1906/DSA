Given a string s, return the longest palindromic substring in s.

 

Example 1:

Input: s = "babad"
Output: "bab"
Explanation: "aba" is also a valid answer.
Example 2:

Input: s = "cbbd"
Output: "bb"
 

Constraints:

1 <= s.length <= 1000
s consist of only digits and English letters


Solution:
class Solution(object):
    def longestPalindrome(self, s):
        """
        :type s: str
        :rtype: str
        """
        if not s:
            return ""
        n = len(s)
        max_count = 0
        final = ""

        for i in range(n):
            check = ""
            for j in range(i, n):
                check += s[j]
                if check == check[::-1]:
                    count = len(check)
                    if count > max_count:
                        max_count = count
                        final = check

        return final


