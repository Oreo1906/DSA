class Solution(object):
    def minScore(self, n, roads):

        adj = {}

        for i in range(1, n+1):
            adj[i] = []

        for u, v, w in roads:
            adj[u].append((v, w))
            adj[v].append((u, w))

        self.ans = float("inf")
        visited = set()

        def dfs(node):
            visited.add(node)

            for nei, wt in adj[node]:
                self.ans = min(self.ans, wt)

                if nei not in visited:
                    dfs(nei)

        dfs(1)

        return self.ans
